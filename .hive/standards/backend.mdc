## 11. Testing Standards

### Coverage threshold: 80%

### Test file naming and location

```
tests/
├── conftest.py                          # Fixtures: async client, DB session, factories
├── unit/
│   ├── test_create_employee_use_case.py
│   └── test_employee_entity.py
└── integration/
    └── test_employees_api.py
```

### Unit test pattern (pytest + pytest-asyncio)

```python
# tests/unit/test_create_employee_use_case.py
import pytest
from unittest.mock import AsyncMock
from src.application.use_cases.create_employee import CreateEmployeeUseCase
from src.application.schemas.employee import CreateEmployeeRequest
from src.domain.exceptions import ConflictError


@pytest.mark.asyncio
async def test_create_employee_succeeds_with_valid_data():
    # Arrange
    repo = AsyncMock()
    repo.get_by_email.return_value = None
    repo.save.side_effect = lambda e: e
    use_case = CreateEmployeeUseCase(repo)

    # Act
    result = await use_case.execute(
        CreateEmployeeRequest(first_name="Jane", last_name="Doe", email="jane@example.com")
    )

    # Assert
    assert result.email == "jane@example.com"
    repo.save.assert_called_once()


@pytest.mark.asyncio
async def test_create_employee_raises_conflict_when_email_exists():
    # Arrange
    repo = AsyncMock()
    repo.get_by_email.return_value = object()  # Simulate existing employee
    use_case = CreateEmployeeUseCase(repo)

    # Act & Assert
    with pytest.raises(ConflictError, match="jane@example.com"):
        await use_case.execute(
            CreateEmployeeRequest(first_name="Jane", last_name="Doe", email="jane@example.com")
        )
```

### Integration test pattern (httpx AsyncClient)

```python
# tests/integration/test_employees_api.py
import pytest
from httpx import AsyncClient


@pytest.mark.asyncio
async def test_create_employee_returns_201(client: AsyncClient, auth_headers: dict):
    response = await client.post(
        "/api/v1/employees",
        json={"first_name": "Jane", "last_name": "Doe", "email": "jane@example.com"},
        headers=auth_headers,
    )
    assert response.status_code == 201
    assert response.json()["email"] == "jane@example.com"


@pytest.mark.asyncio
async def test_create_employee_returns_409_when_email_exists(client: AsyncClient, auth_headers: dict):
    payload = {"first_name": "Jane", "last_name": "Doe", "email": "jane@example.com"}
    await client.post("/api/v1/employees", json=payload, headers=auth_headers)
    response = await client.post("/api/v1/employees", json=payload, headers=auth_headers)
    assert response.status_code == 409
```

### Fixtures (conftest.py)

```python
# tests/conftest.py
import pytest_asyncio
from httpx import AsyncClient, ASGITransport
from src.presentation.main import app
from src.infrastructure.database.session import get_session

@pytest_asyncio.fixture
async def client(session):
    app.dependency_overrides[get_session] = lambda: session
    async with AsyncClient(transport=ASGITransport(app=app), base_url="http://test") as c:
        yield c
    app.dependency_overrides.clear()
```

### Required test categories per feature

1. Happy path — valid inputs, expected output
2. Validation errors — missing/invalid fields (422)
3. Not found — entity doesn't exist (404)
4. Conflicts — duplicate data (409)
5. Server errors — repository failure (500)
6. Auth — unauthenticated request (401)

