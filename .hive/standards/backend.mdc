## 7. FastAPI Router Pattern

Routers are thin — parse request, call use case, format response.

```python
# presentation/routers/employees.py
from uuid import UUID
from fastapi import APIRouter, Depends, Query, status
from src.application.schemas.employee import CreateEmployeeRequest, EmployeeResponse, EmployeeListResponse
from src.presentation.deps import get_employee_use_cases, get_current_user

router = APIRouter(prefix="/api/v1/employees", tags=["employees"])


@router.post("", response_model=EmployeeResponse, status_code=status.HTTP_201_CREATED)
async def create_employee(
    data: CreateEmployeeRequest,
    use_cases=Depends(get_employee_use_cases),
    _user=Depends(get_current_user),
):
    return await use_cases.create.execute(data)


@router.get("/{employee_id}", response_model=EmployeeResponse)
async def get_employee(
    employee_id: UUID,
    use_cases=Depends(get_employee_use_cases),
    _user=Depends(get_current_user),
):
    return await use_cases.get_by_id.execute(employee_id)


@router.get("", response_model=EmployeeListResponse)
async def list_employees(
    offset: int = Query(0, ge=0),
    limit: int = Query(20, ge=1, le=100),
    use_cases=Depends(get_employee_use_cases),
    _user=Depends(get_current_user),
):
    return await use_cases.list.execute(offset, limit)
```

### Lifespan for startup/shutdown

```python
# presentation/main.py
from contextlib import asynccontextmanager
from fastapi import FastAPI
from src.infrastructure.database.session import engine


@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup
    yield
    # Shutdown
    await engine.dispose()


app = FastAPI(title="My API", lifespan=lifespan)
app.include_router(employees_router)
```

