## 5. Use Case Pattern (Application Layer)

```python
# application/use_cases/create_employee.py
from src.domain.entities.employee import Employee
from src.domain.exceptions import ConflictError
from src.domain.repositories.employee_repository import EmployeeRepositoryProtocol
from src.application.schemas.employee import CreateEmployeeRequest, EmployeeResponse


class CreateEmployeeUseCase:
    def __init__(self, employee_repo: EmployeeRepositoryProtocol) -> None:
        self._employee_repo = employee_repo

    async def execute(self, request: CreateEmployeeRequest) -> EmployeeResponse:
        existing = await self._employee_repo.get_by_email(request.email)
        if existing:
            raise ConflictError(f"Email '{request.email}' is already registered")

        employee = Employee.create(request.first_name, request.last_name, request.email)
        saved = await self._employee_repo.save(employee)
        return EmployeeResponse.model_validate(saved)
```

