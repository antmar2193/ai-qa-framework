## 9. Error Handling

```python
# domain/exceptions.py
class DomainError(Exception):
    """Base class for all domain errors."""

class NotFoundError(DomainError):
    def __init__(self, resource: str, id: object) -> None:
        super().__init__(f"{resource} with id '{id}' was not found")
        self.resource = resource
        self.id = id

class ConflictError(DomainError):
    pass

class ValidationError(DomainError):
    pass

class ForbiddenError(DomainError):
    pass
```

```python
# presentation/exception_handlers.py
from fastapi import Request
from fastapi.responses import JSONResponse
from src.domain.exceptions import NotFoundError, ConflictError, ValidationError, ForbiddenError
import structlog

logger = structlog.get_logger()


async def not_found_handler(request: Request, exc: NotFoundError) -> JSONResponse:
    logger.warning("not_found", resource=exc.resource, id=exc.id, path=request.url.path)
    return JSONResponse(status_code=404, content={"detail": str(exc), "code": "NOT_FOUND"})


async def conflict_handler(request: Request, exc: ConflictError) -> JSONResponse:
    logger.warning("conflict", detail=str(exc))
    return JSONResponse(status_code=409, content={"detail": str(exc), "code": "CONFLICT"})


# Register in main.py:
# app.add_exception_handler(NotFoundError, not_found_handler)
# app.add_exception_handler(ConflictError, conflict_handler)
```

HTTP status mapping:

| Situation | Code |
|---|---|
| Success GET/PUT/PATCH | 200 |
| Created POST | 201 |
| No content DELETE | 204 |
| Validation error | 400 |
| Unauthorized | 401 |
| Forbidden | 403 |
| Not found | 404 |
| Conflict (duplicate) | 409 |
| Server error | 500 |

